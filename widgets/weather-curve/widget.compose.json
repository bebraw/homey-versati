{
  "name": {
    "en": "Versati Weather Curve"
  },
  "height": 480,
  "transparent": false,
  "devices": {
    "type": "app",
    "singular": true,
    "filter": {
      "class": "heater",
      "capabilities": "weather_curve_heating_target"
    }
  },
  "api": {
    "getCurve": {
      "method": "GET",
      "path": "/"
    },
    "updateCurve": {
      "method": "PUT",
      "path": "/"
    },
    "pauseCurve": {
      "method": "POST",
      "path": "/pause"
    },
    "resumeCurve": {
      "method": "POST",
      "path": "/resume"
    },
    "setBoost": {
      "method": "POST",
      "path": "/boost"
    },
    "clearBoost": {
      "method": "DELETE",
      "path": "/boost"
    }
  }
}
