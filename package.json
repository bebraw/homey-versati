{
  "name": "homey-versati",
  "version": "0.1.0",
  "private": true,
  "description": "Homey app for read-only Gree Versati heat pump discovery and telemetry",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "probe:fields": "npm run build && node .homeybuild/scripts/probe-fields.js",
    "snapshot": "npm run build && node .homeybuild/scripts/snapshot.js",
    "test": "npm run build && node --test .homeybuild/test/*.test.js",
    "validate": "npm run test"
  },
  "dependencies": {
    "homey": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20"
  }
}
