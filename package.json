{
  "name": "homey-versati",
  "version": "0.1.0",
  "private": true,
  "description": "Homey app for local Gree Versati heat pump monitoring and limited control",
  "main": ".homeybuild/src/app.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bebraw/homey-versati.git"
  },
  "bugs": {
    "url": "https://github.com/bebraw/homey-versati/issues"
  },
  "homepage": "https://github.com/bebraw/homey-versati#readme",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "probe:diagnostics": "npm run build && node .homeybuild/scripts/probe-diagnostics.js",
    "probe:fields": "npm run build && node .homeybuild/scripts/probe-fields.js",
    "smoke:toggles": "npm run build && node .homeybuild/scripts/smoke-toggles.js",
    "snapshot": "npm run build && node .homeybuild/scripts/snapshot.js",
    "test": "npm run build && node --test .homeybuild/test/*.test.js",
    "test:live": "npm run build && node .homeybuild/scripts/test-live.js",
    "validate": "npm run test && homey app validate"
  },
  "dependencies": {
    "homey": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20"
  }
}
