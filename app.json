  "widgets": {
    "weather-curve": {
      "id": "weather-curve",
      "name": {
        "en": "Versati Weather Curve"
      },
      "height": 480,
      "transparent": false,
      "devices": {
        "type": "app",
        "singular": true,
        "filter": {
          "class": "heater",
          "capabilities": "weather_curve_heating_target"
        }
      },
      "settings": [],
      "api": {
        "getCurve": {
          "method": "GET",
          "path": "/"
        },
        "updateCurve": {
          "method": "PUT",
          "path": "/"
        },
        "pauseCurve": {
          "method": "POST",
          "path": "/pause"
        },
        "resumeCurve": {
          "method": "POST",
          "path": "/resume"
        },
        "setBoost": {
          "method": "POST",
          "path": "/boost"
        },
        "clearBoost": {
          "method": "DELETE",
          "path": "/boost"
        },
        "exportCurve": {
          "method": "GET",
          "path": "/profile"
        },
        "importCurve": {
          "method": "PUT",
          "path": "/profile"
        }
      }
    },
    "telemetry-graphs": {
      "id": "telemetry-graphs",
      "name": {
        "en": "Versati Graphs"
      },
      "height": 500,
      "transparent": false,
      "devices": {
        "type": "app",
        "singular": true,
        "filter": {
          "class": "heater",
          "capabilities": "measure_temperature_water_out"
        }
      },
      "settings": [],
      "api": {
        "getTelemetry": {
          "method": "GET",
          "path": "/"
        },
        "getDiagnostics": {
          "method": "GET",
          "path": "/diagnostics"
        }
      }
    }
  },
  "flow": {
    "triggers": [
      {
        "id": "measure_temperature_hot_water_changed",
        "title": {
          "en": "Hot water temperature changed"
        },
        "tokens": [
          {
            "name": "measure_temperature_hot_water",
            "type": "number",
            "title": {
              "en": "Temperature"
            },
            "example": {
              "en": "50.6"
            }
          }
        ]
      },
      {
        "id": "target_temperature_heating_changed",
        "title": {
          "en": "Heating target changed"
        },
        "tokens": [
          {
            "name": "target_temperature_heating",
            "type": "number",
            "title": {
              "en": "Temperature"
            },
            "example": {
              "en": "35"
            }
          }
        ]
      },
      {
        "id": "target_temperature_hot_water_changed",
        "title": {
          "en": "Hot water target changed"
        },
        "tokens": [
          {
            "name": "target_temperature_hot_water",
            "type": "number",
            "title": {
              "en": "Temperature"
            },
            "example": {
              "en": "50"
            }
          }
        ]
      },
      {
        "id": "heatpump_mode_changed",
        "title": {
          "en": "Mode changed"
        },
        "tokens": [
          {
            "name": "heatpump_mode",
            "type": "string",
            "title": {
              "en": "Mode"
            },
            "example": {
              "en": "heat_hot_water"
            }
          }
        ]
      },
      {
        "id": "weather_curve_outdoor_temperature_changed",
        "title": {
          "en": "Curve outdoor temperature changed"
        },
        "tokens": [
          {
