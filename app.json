  "flow": {
    "triggers": [
      {
        "id": "measure_temperature_hot_water_changed",
        "title": {
          "en": "Hot water temperature changed"
        },
        "tokens": [
          {
            "name": "measure_temperature_hot_water",
            "type": "number",
            "title": {
              "en": "Temperature"
            },
            "example": {
              "en": "50.6"
            }
          }
        ]
      },
      {
        "id": "target_temperature_heating_changed",
        "title": {
          "en": "Heating target changed"
        },
        "tokens": [
          {
            "name": "target_temperature_heating",
            "type": "number",
            "title": {
              "en": "Temperature"
            },
            "example": {
              "en": "35"
            }
          }
        ]
      },
      {
        "id": "target_temperature_hot_water_changed",
        "title": {
          "en": "Hot water target changed"
