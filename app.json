{
  "id": "com.gree.versati",
  "version": "0.1.0",
  "sdk": 3,
  "compatibility": ">=12.3.0",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Gree Versati"
  },
  "author": {
    "name": "Juhovepsalainen"
  },
  "contributors": {
    "developers": [
      {
        "name": "Roi Huvaara"
      }
    ]
  },
  "description": {
    "en": "Local monitoring and limited control for Gree Versati air-to-water heat pumps."
  },
  "brandColor": "#0f766e",
  "category": "climate",
  "tags": {
    "en": [
      "Gree",
      "Versati",
      "heat pump",
      "heatpump",
      "climate",
      "energy",
      "local"
    ]
  },
  "source": "https://github.com/bebraw/homey-versati",
  "bugs": {
    "url": "https://github.com/bebraw/homey-versati/issues"
  },
  "support": "https://github.com/bebraw/homey-versati/issues",
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png"
  },
  "drivers": [
    {
      "id": "versati",
      "name": {
        "en": "Gree Versati"
      },
      "class": "heater",
      "images": {
        "small": "/drivers/versati/assets/images/small.png",
        "large": "/drivers/versati/assets/images/large.png"
      },
      "capabilities": [
        "measure_temperature_water_out",
        "measure_temperature_water_in",
        "measure_temperature_hot_water",
        "measure_temperature_optional_water",
        "measure_temperature_remote_room",
        "target_temperature_heating",
        "target_temperature_cooling",
        "target_temperature_hot_water",
        "heatpump_power",
        "heatpump_mode",
        "heatpump_fast_hot_water",
        "heatpump_silence",
        "heatpump_weather_dependent",
        "heatpump_disinfect",
        "heatpump_defrosting",
        "heatpump_tank_heater",
        "heatpump_hp_heater_1",
        "heatpump_hp_heater_2",
        "heatpump_frost_protection",
        "heatpump_evu",
        "weather_curve_outdoor_temperature",
        "weather_curve_heating_target",
        "button.refresh"
      ],
      "capabilitiesOptions": {
        "measure_temperature_water_out": {
          "preventInsights": false
        },
        "measure_temperature_water_in": {
          "preventInsights": false
        },
        "measure_temperature_hot_water": {
          "preventInsights": false
        },
        "measure_temperature_optional_water": {
          "preventInsights": false
        },
        "measure_temperature_remote_room": {
          "preventInsights": false
        },
        "target_temperature_heating": {
          "preventInsights": false
        },
        "target_temperature_cooling": {
          "preventInsights": false
        },
        "target_temperature_hot_water": {
          "preventInsights": false
        },
        "heatpump_power": {
          "preventInsights": false
        },
        "heatpump_mode": {
          "preventInsights": false
        },
        "heatpump_fast_hot_water": {
          "preventInsights": false
        },
        "heatpump_silence": {
          "preventInsights": false
        },
        "heatpump_weather_dependent": {
          "preventInsights": false
        },
        "heatpump_disinfect": {
          "preventInsights": false
        },
        "heatpump_defrosting": {
          "preventInsights": false
        },
        "heatpump_tank_heater": {
          "preventInsights": false
        },
        "heatpump_hp_heater_1": {
          "preventInsights": false
        },
        "heatpump_hp_heater_2": {
          "preventInsights": false
        },
        "heatpump_frost_protection": {
          "preventInsights": false
        },
        "heatpump_evu": {
          "preventInsights": false
        },
        "weather_curve_outdoor_temperature": {
          "preventInsights": false
        },
        "weather_curve_heating_target": {
          "preventInsights": false
        },
        "button.refresh": {
          "maintenanceAction": true,
          "title": {
            "en": "Refresh now"
          },
          "desc": {
            "en": "Poll the heat pump immediately and update Homey capabilities."
          }
        }
      },
      "pair": [
        {
          "id": "start"
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          },
          "options": {
            "singular": true
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        },
        {
          "id": "manual"
        }
      ],
      "settings": [
        {
          "id": "ip",
          "type": "text",
          "label": {
            "en": "IP address"
          },
          "hint": {
            "en": "Current local IP address of the heat pump."
          },
          "value": "",
          "highlight": true
        },
        {
          "id": "port",
          "type": "number",
          "label": {
            "en": "UDP port"
          },
          "hint": {
            "en": "Gree Versati LAN protocol port. Usually 7000."
          },
          "value": 7000
        },
        {
          "id": "mac",
          "type": "text",
          "label": {
            "en": "MAC address"
          },
          "hint": {
            "en": "Device MAC address without separators also works."
          },
          "value": "",
          "highlight": true
        },
        {
          "id": "key",
          "type": "password",
          "label": {
            "en": "Device key"
          },
          "hint": {
            "en": "Leave empty to rebind when changing endpoint details."
          },
          "value": "",
          "highlight": true
        },
        {
          "id": "encryptionVersion",
          "type": "dropdown",
          "label": {
            "en": "Encryption version"
          },
          "hint": {
            "en": "Detected during binding. Use version 1 unless diagnostics show otherwise."
          },
          "value": "1",
          "values": [
            {
              "id": "1",
              "label": {
                "en": "Version 1 (AES-ECB)"
              }
            },
            {
              "id": "2",
              "label": {
                "en": "Version 2 (AES-GCM)"
              }
            }
          ]
        },
        {
          "id": "pollInterval",
          "type": "number",
          "label": {
            "en": "Poll interval"
          },
          "hint": {
            "en": "Polling interval in seconds. Changes apply after app restart."
          },
          "value": 30,
          "min": 15,
          "max": 300
        },
        {
          "id": "curvePreset",
          "type": "dropdown",
          "label": {
            "en": "Curve preset"
          },
          "hint": {
            "en": "Choose a starting profile. Custom uses the detailed curve settings below."
          },
          "value": "custom",
          "values": [
            {
              "id": "custom",
              "label": {
                "en": "Custom"
              }
            },
            {
              "id": "mild_floor",
              "label": {
                "en": "Mild floor heating"
              }
            },
            {
              "id": "radiators",
              "label": {
                "en": "Radiators"
              }
            },
            {
              "id": "conservative",
              "label": {
                "en": "Conservative"
              }
            }
          ]
        },
        {
          "id": "curveControlMode",
          "type": "dropdown",
          "label": {
            "en": "Homey curve control"
          },
          "hint": {
            "en": "Dry run only calculates the target. Write target lets Homey update the heating water target from its own two-point curve."
          },
          "value": "dry_run",
          "values": [
            {
              "id": "disabled",
              "label": {
                "en": "Disabled"
              }
            },
            {
              "id": "dry_run",
              "label": {
                "en": "Dry run"
              }
            },
            {
              "id": "write",
              "label": {
                "en": "Write heating target"
              }
            }
          ]
        },
        {
          "id": "curveOutdoorSource",
          "type": "dropdown",
          "label": {
            "en": "Curve outdoor source"
          },
          "hint": {
            "en": "Use a manual temperature, or let a Homey Flow feed an outdoor sensor/weather value."
          },
          "value": "manual",
          "values": [
            {
              "id": "manual",
              "label": {
                "en": "Manual temperature"
              }
            },
            {
              "id": "flow",
              "label": {
                "en": "Flow-provided temperature"
              }
            }
          ]
        },
        {
          "id": "curveManualOutdoorTemperature",
          "type": "number",
          "label": {
            "en": "Manual outdoor temperature"
          },
          "hint": {
            "en": "Used only when curve outdoor source is manual."
          },
          "value": 0,
          "min": -50,
          "max": 50
        },
        {
          "id": "curveOutdoorLow",
          "type": "number",
          "label": {
            "en": "Outdoor low"
          },
          "hint": {
            "en": "Outdoor temperature for the high water target point."
          },
          "value": -20,
          "min": -50,
          "max": 30
        },
        {
          "id": "curveTargetAtOutdoorLow",
          "type": "number",
          "label": {
            "en": "Target at outdoor low"
          },
          "hint": {
            "en": "Heating water target when outdoor temperature is at outdoor low."
          },
          "value": 40,
          "min": 20,
          "max": 55
        },
        {
          "id": "curveOutdoorHigh",
          "type": "number",
          "label": {
            "en": "Outdoor high"
          },
          "hint": {
            "en": "Outdoor temperature for the low water target point."
          },
          "value": 10,
          "min": -30,
          "max": 50
        },
        {
          "id": "curveTargetAtOutdoorHigh",
          "type": "number",
          "label": {
            "en": "Target at outdoor high"
          },
          "hint": {
            "en": "Heating water target when outdoor temperature is at outdoor high."
          },
          "value": 25,
          "min": 20,
          "max": 55
        },
        {
          "id": "curveTargetMin",
          "type": "number",
          "label": {
            "en": "Curve target minimum"
          },
          "hint": {
            "en": "Minimum Homey-managed heating water target."
          },
          "value": 20,
          "min": 20,
          "max": 55
        },
        {
          "id": "curveTargetMax",
          "type": "number",
          "label": {
            "en": "Curve target maximum"
          },
          "hint": {
            "en": "Maximum Homey-managed heating water target."
          },
          "value": 55,
          "min": 20,
          "max": 55
        },
        {
          "id": "curveBoostTargetMin",
          "type": "number",
          "label": {
            "en": "Boost target minimum"
          },
          "hint": {
            "en": "Minimum heating water target while a temporary Homey curve boost is active."
          },
          "value": 20,
          "min": 20,
          "max": 55
        },
        {
          "id": "curveBoostTargetMax",
          "type": "number",
          "label": {
            "en": "Boost target maximum"
          },
          "hint": {
            "en": "Maximum heating water target while a temporary Homey curve boost is active."
          },
          "value": 55,
          "min": 20,
          "max": 55
        },
        {
          "id": "curveShape",
          "type": "dropdown",
          "label": {
            "en": "Curve shape"
          },
          "hint": {
            "en": "Linear keeps the two-point curve straight. Presets bend the interpolation; custom uses the curve bend value."
          },
          "value": "linear",
          "values": [
            {
              "id": "linear",
              "label": {
                "en": "Linear"
              }
            },
            {
              "id": "mild",
              "label": {
                "en": "Mild bend"
              }
            },
            {
              "id": "normal",
              "label": {
                "en": "Normal bend"
              }
            },
            {
              "id": "aggressive",
              "label": {
                "en": "Aggressive bend"
              }
            },
            {
              "id": "custom",
              "label": {
                "en": "Custom bend"
              }
            }
          ]
        },
        {
          "id": "curveBend",
          "type": "number",
          "label": {
            "en": "Curve bend"
          },
          "hint": {
            "en": "Used only when curve shape is custom. Negative keeps target higher for longer; positive lowers target earlier."
          },
          "value": 0,
          "min": -100,
          "max": 100
        },
        {
          "id": "curveDeadband",
          "type": "number",
          "label": {
            "en": "Curve write deadband"
          },
          "hint": {
            "en": "Only write when the calculated target differs from the current heating target by at least this many degrees."
          },
          "value": 1,
          "min": 0,
          "max": 10
        },
        {
          "id": "curveMinWriteInterval",
          "type": "number",
          "label": {
            "en": "Curve minimum write interval"
          },
          "hint": {
            "en": "Minimum seconds between automatic curve target writes."
          },
          "value": 1800,
          "min": 300,
          "max": 86400
        }
      ]
    }
  ],
