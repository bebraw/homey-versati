    "conditions": [
      {
        "id": "mode_is",
        "title": {
          "en": "Mode !{{is|isn't}} ..."
        },
        "titleFormatted": {
          "en": "Mode !{{is|isn't}} [[mode]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=versati"
          },
          {
            "name": "mode",
            "type": "dropdown",
            "values": [
              {
                "id": "off",
                "label": {
                  "en": "Off"
                }
              },
              {
                "id": "hot_water",
                "label": {
                  "en": "Hot water"
                }
              },
              {
                "id": "heat_hot_water",
                "label": {
                  "en": "Heat + hot water"
                }
              },
              {
                "id": "cool",
                "label": {
                  "en": "Cool"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "hot_water_below",
        "title": {
          "en": "Hot water temperature !{{is below|is not below}} ..."
        },
        "titleFormatted": {
          "en": "Hot water temperature !{{is below|is not below}} [[temperature]] °C"
        },
        "args": [
          {
            "type": "device",
