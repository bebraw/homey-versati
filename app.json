        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=versati"
          }
        ]
      },
      {
        "id": "disinfect_is_on",
        "title": {
          "en": "Disinfect !{{is|isn't}} enabled"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
