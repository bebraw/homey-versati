            },
            "example": {
              "en": "2.5"
            }
          }
        ]
      },
      {
        "id": "weather_curve_heating_target_changed",
        "title": {
          "en": "Curve heating target changed"
        },
        "tokens": [
          {
            "name": "heating_target",
            "type": "number",
            "title": {
              "en": "Heating target"
            },
            "example": {
              "en": "34"
            }
          }
        ]
      },
      {
        "id": "weather_curve_written",
        "title": {
          "en": "Weather curve wrote heating target"
        },
        "tokens": [
          {
            "name": "outdoor_temperature",
            "type": "number",
            "title": {
              "en": "Outdoor temperature"
            },
            "example": {
              "en": "2.5"
            }
          },
          {
            "name": "heating_target",
            "type": "number",
            "title": {
              "en": "New heating target"
            },
            "example": {
              "en": "34"
            }
          },
          {
            "name": "previous_heating_target",
