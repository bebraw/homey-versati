      }
    ],
    "actions": [
      {
        "id": "set_mode",
        "title": {
          "en": "Set mode"
        },
        "titleFormatted": {
          "en": "Set mode to [[mode]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=versati"
