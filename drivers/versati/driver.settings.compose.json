  {
    "id": "copWaterFlowNominalKw",
    "type": "text",
    "label": {
      "en": "COP nominal heat output"
    },
    "hint": {
      "en": "Nominal heat-pump output in kW. When above 0, Homey estimates water flow from this and a 5 degree water delta. Set to 0 to enter water flow manually below."
    },
    "value": "0"
  },
  {
    "id": "copWaterFlowRateLMin",
    "type": "text",
    "label": {
      "en": "COP water flow"
    },
    "hint": {
      "en": "Manual heating circuit flow in L/min, used when nominal heat output is 0. Examples: 4 kW=11.5, 6=17.2, 8=22.9, 10=28.7, 12=34.4, 14=40.1, 16=45.9. Set both flow inputs to 0 to disable COP."
    },
    "value": "0"
  },
  {
    "id": "copElectricalInputKw",
    "type": "number",
    "label": {
      "en": "COP electrical input"
    },
    "hint": {
      "en": "Estimated whole heat-pump electrical input in kW. Prefer a meter covering indoor and outdoor unit consumption."
    },
    "value": 0,
    "min": 0,
    "max": 50
  },
  {
    "id": "copLowThreshold",
    "type": "number",
    "label": {
      "en": "Low COP threshold"
    },
    "hint": {
      "en": "Triggers the low-COP Flow when Estimated COP crosses below this value. Set to 0 to disable the alert."
    },
    "value": 2,
    "min": 0,
    "max": 10
  },
  {
    "id": "alertDefrostingMinutes",
    "type": "number",
    "label": {
      "en": "Defrosting alert delay"
    },
    "hint": {
      "en": "Trigger an alert after defrosting has stayed active this many minutes. Set to 0 to disable."
    },
    "value": 20,
    "min": 0,
    "max": 240
  },
  {
    "id": "alertBackupHeaterMinutes",
    "type": "number",
    "label": {
      "en": "Backup heater alert delay"
