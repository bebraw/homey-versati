    "hint": {
      "en": "Trigger an alert after tank/HP heater status has stayed active this many minutes. Set to 0 to disable."
    },
    "value": 30,
    "min": 0,
    "max": 240
  },
  {
    "id": "alertLowWaterDelta",
    "type": "number",
    "label": {
      "en": "Low water delta threshold"
